{
  "name": "pak-tel",
  "version": "1.0.0",
  "private": true,
  "description": "Pak-Tel storefront and eSIM portal",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port ${PORT:-8787} --show-interactive-dev-session=false",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply my-pak-tel --local",
    "db:migrate": "wrangler d1 migrations apply my-pak-tel --remote",
    "dpay:webhook": "node scripts/register-dpay-webhook.mjs",
    "test": "node test/e2e.mjs && node --test test/notifications.test.mjs test/preview-catalogue.test.mjs",
    "vendor:dynaura": "node scripts/vendor-dynaura.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "dynaura": "0.2.1",
    "qrcode-generator": "^2.0.4"
  }
}
